---
import { site, downloads } from '../data/site';
import { getContent, languages, toLang, urlFor } from '../i18n';
import '../styles/global.css';

interface Props {
  title?: string;
}

const lang = toLang(Astro.currentLocale);
const t = getContent(lang);

const { title } = Astro.props;
const description = t.meta.description;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${t.meta.tagline}`;
// Not from Astro.url.pathname — see the note on pathFor. That would emit
// `/es/`, which this host redirects, making the canonical point at a 301.
const canonical = urlFor(lang, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}/og.jpg`.replace(/\/+/g, '/'), Astro.site).href;

/*
  Structured data. SoftwareApplication is what search engines use to show a
  rich result for an app — name, platform, price — and the FAQ block is what
  gets a question expanded directly in results. Both mirror copy that is
  visible on the page, which is the condition for them being honoured — so
  both are built from this page's language, not from English.
*/
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description,
  inLanguage: t.htmlLang,
  applicationCategory: 'ProductivityApplication',
  operatingSystem: downloads.map((d) => t.download.platforms[d.key].platform).join(', '),
  softwareVersion: site.version,
  url: canonical,
  downloadUrl: site.releases,
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: site.author },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: t.htmlLang,
  mainEntity: t.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!doctype html>
<html lang={t.htmlLang} class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0a0c" />

    {/*
      Every language points at every other, itself included — a crawler that
      lands on one has to be able to reach the whole set, and a page that omits
      its own hreflang is ignored by Google. x-default names the version served
      to a reader whose language we do not have.
    */}
    {
      languages.map((l) => (
        <link rel="alternate" hreflang={getContent(l).hreflang} href={urlFor(l, Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={urlFor('en', Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="862" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/+/g, '/')}
      type="image/svg+xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </head>

  <body class="font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-clay-400 focus:px-4 focus:py-2 focus:text-ink-950"
    >
      {t.nav.skipToContent}
    </a>
    <slot />
  </body>
</html>
