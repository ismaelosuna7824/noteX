---
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroRow from '../components/HeroRow.astro';
import Features from '../components/Features.astro';
import Tour from '../components/Tour.astro';
import Download from '../components/Download.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

/*
  A side-by-side comparison page for the row-layout hero, not a second
  landing page. It is marked noindex: two URLs with near-identical copy would
  compete with each other in search, and the whole point of this page is to be
  deleted once a hero wins.
*/
---

<Base title="Hero variant" noindex>
  <Motion />
  <SiteHeader />
  <HeroRow />
  <main id="main">
    <Features />
    <Tour />
    <Download />
    <Faq />
  </main>
  <Footer />
</Base>
