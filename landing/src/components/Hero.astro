---
import { site } from '../data/site';
import GithubLink from './GithubLink.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="relative isolate overflow-hidden">
  <!--
    Ambient light, the signature of the style this page is built in. Two slow
    blobs behind everything, blurred past recognition so they read as glow
    rather than shapes. Decorative only — never behind body copy.
  -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div
      class="ambient absolute -top-40 -left-32 h-[38rem] w-[38rem] rounded-full bg-clay-500/20 blur-[120px]"
    >
    </div>
    <div
      class="ambient ambient--slow absolute -top-24 right-0 h-[32rem] w-[32rem] rounded-full bg-indigo-500/10 blur-[120px]"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-b from-transparent to-ink-950"></div>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <nav class="flex items-center justify-between py-6" aria-label="Main">
      <span class="text-lg font-bold tracking-tight">{site.name}</span>

      <div class="flex items-center gap-6 text-sm">
        <a
          href="#features"
          class="hidden cursor-pointer text-white/70 transition duration-200 hover:text-white sm:block"
        >
          Features
        </a>
        <a
          href="#tour"
          class="hidden cursor-pointer text-white/70 transition duration-200 hover:text-white sm:block"
        >
          Tour
        </a>
        <a
          href="#faq"
          class="hidden cursor-pointer text-white/70 transition duration-200 hover:text-white sm:block"
        >
          FAQ
        </a>
        <GithubLink />
      </div>
    </nav>

    <div class="pt-16 pb-10 text-center sm:pt-24">
      <p
        data-reveal
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm text-white/70"
      >
        <span class="relative flex h-1.5 w-1.5">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-clay-400 opacity-75"
          ></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-clay-300"></span>
        </span>
        v{site.version} is out — free and open source
      </p>

      <h1
        data-reveal
        class="mx-auto max-w-4xl text-5xl font-bold leading-[1.03] tracking-tight text-balance sm:text-6xl lg:text-7xl"
        style="transition-delay:80ms"
      >
        Immerse in
        <span
          class="bg-gradient-to-br from-clay-200 via-clay-300 to-clay-500 bg-clip-text text-transparent"
        >
          your notes
        </span>
      </h1>

      <p
        data-reveal
        class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-pretty text-white/65 sm:text-xl"
        style="transition-delay:160ms"
      >
        Markdown notes that feel like somewhere you want to write. Live preview, linked notes, daily
        pages and a focus timer — stored as plain files you can take with you.
      </p>

      <div
        data-reveal
        class="mt-10 flex flex-wrap items-center justify-center gap-4"
        style="transition-delay:240ms"
      >
        <a
          href="#download"
          class="cursor-pointer rounded-full bg-clay-400 px-8 py-3.5 font-semibold text-ink-950 shadow-lg shadow-clay-600/25 transition duration-200 hover:-translate-y-0.5 hover:bg-clay-300 hover:shadow-xl hover:shadow-clay-600/30 active:translate-y-0 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-300"
        >
          Download free
        </a>
        <a
          href="#tour"
          class="cursor-pointer rounded-full border border-white/20 px-8 py-3.5 font-semibold text-white/90 transition duration-200 hover:border-white/45 hover:bg-white/5 hover:text-white active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-400"
        >
          See it in action
        </a>
      </div>

      <p data-reveal class="mt-6 text-sm text-white/45" style="transition-delay:300ms">
        Windows · macOS · Linux · Android — no account required
      </p>
    </div>

    <!--
      The product itself, framed like the desktop app it is. Previously the
      video was a full-bleed backdrop behind the copy, which made the thing
      being sold read as wallpaper. In a window, it is the subject.
    -->
    <div data-reveal class="relative pb-24" style="transition-delay:380ms">
      <div
        class="pointer-events-none absolute -inset-x-8 -top-8 bottom-16 -z-10 rounded-[3rem] bg-clay-500/15 blur-[80px]"
        aria-hidden="true"
      >
      </div>

      <div
        class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-white/12 bg-ink-900 shadow-2xl shadow-black/60"
      >
        <div class="flex items-center gap-2 border-b border-white/8 bg-ink-850 px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
          <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
          <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          <span class="ml-3 text-xs font-medium text-white/35">NoteX</span>
        </div>

        <video
          id="hero-video"
          class="block aspect-[1280/862] w-full bg-ink-900 object-cover"
          poster={`${base}/video/hero-poster.jpg`}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="Screen recording of NoteX: writing a note, switching to split view and browsing the calendar"
        >
          <source src={`${base}/video/hero.webm`} type="video/webm" />
          <source src={`${base}/video/hero.mp4`} type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</header>

<style>
  /*
    Slow oscillation, the "ambient light blobs" the style calls for. Only
    transform and opacity animate, so this stays on the compositor and never
    triggers layout.
  */
  .ambient {
    animation: drift 22s ease-in-out infinite alternate;
    will-change: transform;
  }

  .ambient--slow {
    animation-duration: 30s;
    animation-direction: alternate-reverse;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(4rem, 2.5rem, 0) scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient {
      animation: none;
    }
  }
</style>

<script>
  // Pause the loop when it scrolls out of view. A background video decoding
  // frames nobody can see is pure battery cost on a laptop.
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;

  if (video) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
    } else if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        },
        { threshold: 0.15 },
      ).observe(video);
    }
  }
</script>
