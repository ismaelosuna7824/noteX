---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <p class="font-bold">{site.name}</p>
      <p class="mt-1 text-sm text-white/50">{site.shortDescription}</p>
    </div>

    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-white/60" aria-label="Footer">
      <a href="#features" class="transition hover:text-white">Features</a>
      <a href="#tour" class="transition hover:text-white">Tour</a>
      <a href="#download" class="transition hover:text-white">Download</a>
      <a href={site.repo} rel="noopener" class="transition hover:text-white">Source code</a>
      <a href={site.releases} rel="noopener" class="transition hover:text-white">Releases</a>
    </nav>
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-12">
    <p class="text-sm text-white/35">
      © {year} {site.author} · MIT licensed · Built with Flutter
    </p>
  </div>
</footer>
