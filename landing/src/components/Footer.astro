---
import { site, social } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <p class="font-bold">{site.name}</p>
      <p class="mt-1 text-sm text-white/50">{site.shortDescription}</p>
    </div>

    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-white/60" aria-label="Footer">
      <a href="#features" class="cursor-pointer transition duration-200 hover:text-white">
        Features
      </a>
      <a href="#tour" class="cursor-pointer transition duration-200 hover:text-white">Tour</a>
      <a href="#download" class="cursor-pointer transition duration-200 hover:text-white">
        Download
      </a>
      <a
        href={site.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="cursor-pointer transition duration-200 hover:text-white"
      >
        Source code
      </a>
      <a
        href={site.releases}
        target="_blank"
        rel="noopener noreferrer"
        class="cursor-pointer transition duration-200 hover:text-white"
      >
        Releases
      </a>
    </nav>
  </div>

  <div
    class="mx-auto flex max-w-6xl flex-col-reverse gap-6 px-6 pb-12 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-sm text-white/35">
      © {year} {site.author} · MIT licensed · Built with Flutter
    </p>

    <!--
      h-11 w-11 is 44x44, the minimum comfortable touch target. The visible
      circle can be smaller than the thing you have to hit; the hit area
      cannot.
    -->
    <ul class="flex items-center gap-3">
      {
        social.map((account) => (
          <li>
            <a
              href={account.href}
              target="_blank"
              rel="noopener noreferrer me"
              class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-white/10 text-white/55 transition duration-200 hover:border-white/30 hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-400"
            >
              <span class="sr-only">{`${site.author} on ${account.label}`}</span>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={account.icon} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
