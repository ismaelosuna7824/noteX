---
import { site } from '../data/site';
import { getRepoStats, formatCount } from '../lib/github';

const { stars } = await getRepoStats();
---

<a
  href={site.repo}
  target="_blank"
  rel="noopener noreferrer"
  class="group inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/15 py-1.5 pl-3.5 pr-2 text-sm font-medium text-white/90 transition duration-200 hover:border-white/40 hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-400"
>
  <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
    ></path>
  </svg>

  <span>GitHub</span>

  {
    stars !== null && (
      <span class="flex items-center gap-1 rounded-full bg-white/10 px-2 py-0.5 text-xs tabular-nums text-white/80 transition group-hover:bg-white/15">
        <svg class="h-3 w-3 text-clay-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.31l-5.8 3.05 1.11-6.46-4.7-4.58 6.49-.94L12 2.5z" />
        </svg>
        <span class="sr-only">Stars on GitHub:</span>
        {formatCount(stars)}
      </span>
    )
  }
</a>
