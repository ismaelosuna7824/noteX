---
import { site, downloads } from '../data/site';

/*
  Links point at the /latest/download/ path rather than a pinned tag, so a new
  release is picked up without touching this page — and a stale landing page
  never hands someone an old build.
*/
const assetUrl = (file: string) => `${site.repo}/releases/latest/download/${file}`;

const icons: Record<string, string> = {
  apple:
    'M16.365 1.43c0 1.14-.47 2.22-1.24 3.01-.85.9-2.25 1.6-3.4 1.5-.14-1.1.44-2.28 1.2-3.03.85-.86 2.32-1.5 3.44-1.48ZM20.5 17.2c-.6 1.38-.89 2-1.66 3.22-1.07 1.7-2.58 3.81-4.45 3.83-1.66.01-2.09-1.08-4.35-1.07-2.26.01-2.73 1.09-4.4 1.08-1.87-.02-3.3-1.93-4.37-3.62C-1.7 16.9-2 10.3.9 6.86 2.2 5.28 4.1 4.3 5.9 4.3c1.83 0 2.98 1.09 4.5 1.09 1.47 0 2.36-1.09 4.48-1.09 1.6 0 3.3.87 4.5 2.38-3.96 2.17-3.32 7.83.62 9.36-.5 1.4-.75 1.9-1.5 3.16Z',
  windows: 'M0 3.45 9.75 2.1v9.45H0V3.45Zm10.95-1.5L24 0v11.55H10.95V1.95ZM0 12.75h9.75v9.45L0 20.85v-8.1Zm10.95 0H24V24l-13.05-1.8v-9.45Z',
  linux:
    'M12 0a5.5 5.5 0 0 0-5.5 5.5c0 1.9-.3 3.4-1 4.9-.9 2-2.1 3.6-2.1 5.6 0 1 .4 1.7 1.1 2.1.5.3.8.8.9 1.4.2 1.3 1.3 2.3 2.6 2.3.8 0 1.5-.4 2-1 .6.2 1.3.3 2 .3s1.4-.1 2-.3c.5.6 1.2 1 2 1 1.3 0 2.4-1 2.6-2.3.1-.6.4-1.1.9-1.4.7-.4 1.1-1.1 1.1-2.1 0-2-1.2-3.6-2.1-5.6-.7-1.5-1-3-1-4.9A5.5 5.5 0 0 0 12 0Zm-2.2 5.1c.5 0 .9.6.9 1.3s-.4 1.3-.9 1.3-.9-.6-.9-1.3.4-1.3.9-1.3Zm4.4 0c.5 0 .9.6.9 1.3s-.4 1.3-.9 1.3-.9-.6-.9-1.3.4-1.3.9-1.3ZM12 9.2c1.1 0 2.1.5 2.1 1s-1 1.4-2.1 1.4-2.1-.9-2.1-1.4 1-1 2.1-1Z',
  android:
    'M17.6 9.48l1.84-3.18a.4.4 0 0 0-.7-.4l-1.87 3.23a11.4 11.4 0 0 0-9.74 0L5.26 5.9a.4.4 0 1 0-.7.4L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52ZM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Z',
};
---

<section id="download" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-24 lg:py-32">
  <div data-reveal class="glass rounded-card px-8 py-14 sm:px-14">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Start writing tonight</h2>
      <p class="mt-5 text-lg leading-relaxed text-white/60">
        Free, open source and installed in a minute. No account, no trial, nothing to cancel later.
      </p>
    </div>

    <ul data-reveal-stagger class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        downloads.map((download) => (
          <li>
            <a
              href={assetUrl(download.file)}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full cursor-pointer flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition duration-200 hover:-translate-y-1 hover:border-clay-400/40 hover:bg-white/[0.06] active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-400"
            >
              <svg
                class="h-7 w-7 text-white/70 transition group-hover:text-clay-300"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={icons[download.icon]} />
              </svg>
              <span class="mt-5 font-semibold">{download.platform}</span>
              <span class="mt-1 text-sm text-white/50">{download.note}</span>
              <span class="mt-4 text-sm font-medium text-clay-300">
                Download
                <span aria-hidden="true"> →</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm text-white/45">
      Version {site.version} · MIT licensed ·
      <a href={site.releases} target="_blank"
              rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white/70">
        All releases and changelog
      </a>
    </p>
  </div>
</section>
