---
import { site, downloads, firstRunPlatforms } from '../data/site';
import { getContent, toLang } from '../i18n';
import { getLatestVersion } from '../lib/github';

const t = getContent(toLang(Astro.currentLocale));
const version = await getLatestVersion();

/*
  Links point at the /latest/download/ path rather than a pinned tag, so a new
  release is picked up without touching this page — and a stale landing page
  never hands someone an old build.
*/
const assetUrl = (file: string) => `${site.repo}/releases/latest/download/${file}`;

/** Pairs the language-independent asset with this language's words. */
const items = downloads.map((d) => ({ ...d, ...t.download.platforms[d.key] }));

const firstRun = firstRunPlatforms.map((p) => ({
  platform: t.download.platforms[p.key].platform,
  warning: t.download.firstRun[p.key].warning,
  steps: t.download.firstRun[p.key].steps,
  note: p.key === 'macos' ? t.download.firstRun.macos.note : null,
}));
---

<section id="download" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-24 lg:py-32">
  <div data-reveal class="glass rounded-card px-8 py-14 sm:px-14">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.download.heading}</h2>
      <p class="mt-5 text-lg leading-relaxed text-white/60">
        {t.download.body}
      </p>
    </div>

    <ul data-reveal-stagger class="mt-12 grid gap-4 sm:grid-cols-3">
      {
        items.map((download) => (
          <li>
            <a
              href={assetUrl(download.file)}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full cursor-pointer flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition duration-200 hover:-translate-y-1 hover:border-clay-400/40 hover:bg-white/[0.06] active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-400"
            >
              <svg
                class="h-7 w-7 text-white/70 transition group-hover:text-clay-300"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={download.icon} />
              </svg>
              <span class="mt-5 font-semibold">{download.platform}</span>
              <span class="mt-1 text-sm text-white/50">{download.note}</span>
              <span class="mt-4 text-sm font-medium text-clay-300">
                {t.download.cta}
                <span aria-hidden="true"> →</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    {/*
      A <details> rather than a banner: someone who has not hit the dialog yet
      should not be met with a wall of troubleshooting, and someone who has
      needs it on this page, not in a support thread. Closed by default, works
      with no JavaScript, and the summary says enough to be found by search.
    */}
    <details class="group mt-10 rounded-2xl border border-white/10 bg-white/[0.02]">
      <summary
        class="flex cursor-pointer list-none items-center gap-3 px-6 py-5 text-sm font-medium text-white/70 transition duration-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-400"
      >
        <svg
          class="h-4 w-4 shrink-0 text-clay-400 transition duration-200 group-open:rotate-90"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M7.5 4.5 13 10l-5.5 5.5V4.5Z" />
        </svg>
        {t.download.firstRun.summary}
      </summary>

      <div class="px-6 pb-6 text-sm leading-relaxed text-white/55">
        <p>{t.download.firstRun.body}</p>

        <dl class="mt-6 grid gap-6 sm:grid-cols-2">
          {
            firstRun.map((platform) => (
              <div>
                <dt class="font-semibold text-white/80">{platform.platform}</dt>
                <dd class="mt-1">
                  <p class="text-white/45">{t.download.firstRun.says} {platform.warning}</p>
                  <ol class="mt-3 list-decimal space-y-1 pl-5 marker:text-white/30">
                    {platform.steps.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ol>
                  {platform.note && <p class="mt-3 text-white/40">{platform.note}</p>}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </details>

    <p class="mt-10 text-sm text-white/45">
      <span data-version-line data-template={t.download.versionLine('{v}')}
        >{version ? t.download.versionLine(version) : ''}</span
      >{' '}
      <a href={site.releases} target="_blank"
              rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white/70">
        {t.download.allReleases}
      </a>
    </p>
  </div>
</section>
