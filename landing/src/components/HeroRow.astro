---
import { site } from '../data/site';
import { getRepoStats, formatCount } from '../lib/github';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { stars } = await getRepoStats();

/*
  Row variant: product on the left, argument on the right.

  The reference this is modelled on leans on an App Store award and a 4.8
  rating from 100k reviews. There is no equivalent here and inventing one
  would be the worst thing this page could do, so the trust row states what is
  actually verifiable — the licence, the star count, and that it runs without
  an account.
*/
---

<header class="relative isolate overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="ambient absolute -top-32 -left-40 h-[42rem] w-[42rem] rounded-full bg-clay-500/18 blur-[130px]"
    >
    </div>
    <div
      class="ambient ambient--slow absolute top-20 -right-32 h-[34rem] w-[34rem] rounded-full bg-indigo-500/10 blur-[130px]"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-b from-transparent to-ink-950"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6 pt-32 pb-24 sm:pt-40 lg:pb-32">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-20">
      <!--
        The window is tilted in perspective and allowed to bleed past the
        container on wide screens, so it reads as an object in the room rather
        than a picture pasted on the page.
      -->
      <div data-reveal class="relative lg:-ml-16 xl:-ml-24">
        <div
          class="pointer-events-none absolute -inset-10 -z-10 rounded-[4rem] bg-clay-500/15 blur-[90px]"
          aria-hidden="true"
        >
        </div>

        <div class="hero-tilt">
          <div
            class="overflow-hidden rounded-2xl border border-white/12 bg-ink-900 shadow-2xl shadow-black/70"
          >
            <div class="flex items-center gap-2 border-b border-white/8 bg-ink-850 px-4 py-3">
              <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
              <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
              <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
              <span class="ml-3 text-xs font-medium text-white/35">NoteX</span>
            </div>

            <video
              id="hero-video"
              class="block aspect-[1280/862] w-full bg-ink-900 object-cover"
              poster={`${base}/video/hero-poster.jpg`}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Screen recording of NoteX: writing a note, switching to split view and browsing the calendar"
            >
              <source src={`${base}/video/hero.webm`} type="video/webm" />
              <source src={`${base}/video/hero.mp4`} type="video/mp4" />
            </video>
          </div>
        </div>
      </div>

      <div class="lg:pr-4">
        <!-- Trust row: only claims that can be checked. -->
        <div
          data-reveal
          class="mb-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-white/55"
        >
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-clay-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.31l-5.8 3.05 1.11-6.46-4.7-4.58 6.49-.94L12 2.5z"
              ></path>
            </svg>
            {stars !== null ? `${formatCount(stars)} on GitHub` : 'Open source on GitHub'}
          </span>
          <span class="hidden h-4 w-px bg-white/15 sm:block"></span>
          <span>MIT licensed</span>
          <span class="hidden h-4 w-px bg-white/15 sm:block"></span>
          <span>No account required</span>
        </div>

        <h1
          data-reveal
          class="text-5xl font-bold leading-[1.02] tracking-tight text-balance sm:text-6xl xl:text-7xl"
          style="transition-delay:80ms"
        >
          Writing should
          <span
            class="bg-gradient-to-br from-clay-200 via-clay-300 to-clay-500 bg-clip-text text-transparent"
          >
            feel like this.
          </span>
        </h1>

        <p
          data-reveal
          class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-white/60 sm:text-xl"
          style="transition-delay:160ms"
        >
          Markdown notes with live preview, links between your pages, a note for every day and a
          focus timer — kept as plain files you can take with you.
        </p>

        <div
          data-reveal
          class="mt-9 flex flex-wrap items-center gap-3"
          style="transition-delay:240ms"
        >
          <a
            href="#download"
            class="inline-flex cursor-pointer items-center gap-2.5 rounded-full bg-clay-400 px-7 py-3.5 font-semibold text-ink-950 shadow-lg shadow-clay-600/25 transition duration-200 hover:-translate-y-0.5 hover:bg-clay-300 active:translate-y-0 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-300"
          >
            Download free
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5h-2v2H5v-2H3ZM12 3v10.2l3.6-3.6 1.4 1.4-6 6-6-6 1.4-1.4 3.6 3.6V3h2Z"
              ></path>
            </svg>
          </a>
          <a
            href="#tour"
            class="inline-flex cursor-pointer items-center gap-2.5 rounded-full border border-white/20 px-7 py-3.5 font-semibold text-white/90 transition duration-200 hover:border-white/45 hover:bg-white/5 hover:text-white active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-400"
          >
            See it in action
          </a>
        </div>

        <p data-reveal class="mt-6 text-sm text-white/40" style="transition-delay:300ms">
          Windows · macOS · Linux · v{site.version}
        </p>
      </div>
    </div>
  </div>
</header>

<style>
  /*
    A slight turn away from the viewer. Kept under 7deg: past that the window
    chrome starts to look distorted rather than placed, and the video inside
    becomes harder to read.
  */
  .hero-tilt {
    transform: perspective(1600px) rotateY(5deg) rotateX(1.5deg) scale(1.01);
    transform-origin: left center;
    transition: transform 0.6s var(--ease-expo-out);
  }

  @media (max-width: 1023px) {
    .hero-tilt {
      transform: none;
    }
  }

  .ambient {
    animation: drift 22s ease-in-out infinite alternate;
    will-change: transform;
  }

  .ambient--slow {
    animation-duration: 30s;
    animation-direction: alternate-reverse;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(4rem, 2.5rem, 0) scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient {
      animation: none;
    }

    .hero-tilt {
      transition: none;
    }
  }
</style>

<script>
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;

  if (video) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
    } else if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        },
        { threshold: 0.15 },
      ).observe(video);
    }
  }
</script>
