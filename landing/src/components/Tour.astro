---
import { Image } from 'astro:assets';
import home from '../assets/home.png';
import editor from '../assets/editor.png';
import calendar from '../assets/calendar.png';
import timer from '../assets/timer.png';
import tiling from '../assets/tiling.png';
import settings from '../assets/settings.png';
import { shotOrder } from '../data/site';
import { getContent, toLang } from '../i18n';

/*
  Each shot is paired with the claim it proves. A screenshot with a generic
  caption is decoration; a screenshot answering "what does this actually look
  like when I use it" is the reason people scroll this far.

  `alt` text describes what is on screen for anyone who cannot see it, and is
  also the only thing image search has to go on — so it is translated too, not
  left in English on the Spanish page.

  Images are imported here and paired by key; the words live in src/i18n.
*/
const t = getContent(toLang(Astro.currentLocale));

const images = { home, editor, calendar, timer, tiling, settings };
const shots = shotOrder.map((key) => ({ key, image: images[key], ...t.tour.shots[key] }));
---

<section id="tour" class="scroll-mt-24 border-y border-white/5 bg-ink-900/40 py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.tour.heading}</h2>
      <p class="mt-5 text-lg leading-relaxed text-white/60">
        {t.tour.body}
      </p>
    </div>

    <div class="mt-20 space-y-24 lg:space-y-32">
      {
        shots.map((shot, index) => (
          <article data-reveal class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
            <div class={index % 2 === 1 ? 'lg:order-2' : ''}>
              <p class="text-sm font-semibold uppercase tracking-widest text-clay-400">
                {shot.eyebrow}
              </p>
              <h3 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">{shot.title}</h3>
              <p class="mt-4 text-lg leading-relaxed text-white/60">{shot.body}</p>
            </div>

            <div class={index % 2 === 1 ? 'lg:order-1' : ''}>
              <div class="overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/50">
                <Image
                  src={shot.image}
                  alt={shot.alt}
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 1024px) 40rem, 100vw"
                  format="webp"
                  quality={72}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  class="w-full"
                />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
